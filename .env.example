# Copy to .env and fill in what you have. Everything except TELEGRAM_BOT_TOKEN is optional.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Optional: self-hosted Bot API server (raises file limits from 20/50 MB to 2 GB).
# See README "Large files". Example: http://localhost:8081
TELEGRAM_API_BASE=

# --- Storage ---
DATA_DIR=./data
# PostgreSQL (recommended): postgresql+asyncpg://video_agent:PASSWORD@localhost:5432/video_agent
# Empty = local SQLite file in DATA_DIR (fine for trying things out). Video files are never stored in the database.
DATABASE_URL=
# If set, bot conversation state is kept in Redis instead of memory.
REDIS_URL=

# --- LLM providers (hybrid). Tried in LLM_PROVIDERS order; providers without a key are skipped. ---
LLM_PROVIDERS=anthropic,openrouter,gemini,openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# --- Asset sourcing ---
PEXELS_API_KEY=

# --- Rendering ---
# libx264 (CPU, default) | h264_vaapi (Intel/AMD GPU) | h264_nvenc (NVIDIA)
VIDEO_ENCODER=libx264
OUTPUT_FPS=30
# Path to rife-ncnn-vulkan binary for AI slow-motion. Empty = auto-detect on PATH, else FFmpeg minterpolate.
RIFE_BIN=
MAX_PARALLEL_RENDERS=1

# --- Link downloads (yt-dlp). Optional cookies file for Instagram. ---
YTDLP_COOKIES_FILE=

# --- Meta / Instagram Graph API (not used yet; features stay disabled until set) ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
